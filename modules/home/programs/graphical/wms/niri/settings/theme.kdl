// Active theme — generated by switch_theme.sh (black)

layout {
    gaps 6
    background-color "transparent"

    border {
        on
        width 1
        inactive-color "#595959aa"
        active-gradient from="#ffffffcc" to="#ffffffff" angle=45 relative-to="workspace-view"
    }

    focus-ring {
        off
    }

    shadow {
        off
    }

    struts {
        top 32
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
