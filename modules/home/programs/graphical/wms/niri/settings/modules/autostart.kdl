spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh $HOME/.config/niri/scripts/cleanup_stale_helpers.sh"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh foot --server"
spawn-sh-at-startup "$HOME/.config/niri/scripts/start_quickshell.sh"
spawn-sh-at-startup "$HOME/.config/niri/scripts/start_mail_poll.sh"
spawn-sh-at-startup "$HOME/.config/niri/scripts/start_spotify_cava.sh"
spawn-sh-at-startup "$HOME/.config/niri/scripts/start_libinput_gestures.sh"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh nm-applet --indicator"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh sh -c '$HOME/.config/niri/scripts/apply_saved_theme.sh && $HOME/.config/niri/scripts/startup_wallpaper.sh'"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh sh -c 'rm -f $XDG_RUNTIME_DIR/wob.fifo && mkfifo $XDG_RUNTIME_DIR/wob.fifo'"
spawn-sh-at-startup "$HOME/.config/niri/scripts/run.sh sh -c 'cliphist list | tail -n +501 | cliphist delete 2>/dev/null || true'"
